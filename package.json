{
  "name": "intervalify",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.16",
    "expo-asset": "~58.0.17",
    "expo-audio": "~58.0.9",
    "expo-constants": "~58.0.12",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.24",
    "expo-status-bar": "~58.0.3",
    "i18next": "^26.5.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.9",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit && tsc --project tests/tsconfig.json",
    "check": "npm run typecheck && npm run lint && npm test && npm run validate:levels && npm run verify:assets && npm run validate:i18n",
    "export": "expo export --platform all --max-workers 2 && node scripts/build-offline.mjs dist",
    "test": "tsx --test tests/*.test.ts",
    "validate:levels": "tsx scripts/validate-levels.ts",
    "docs:levels": "tsx scripts/document-levels.ts",
    "verify:audio": "python scripts/verify-audio.py --decode",
    "export:web": "expo export --platform web --max-workers 2 --output-dir dist-web && node scripts/build-offline.mjs dist-web",
    "verify:assets": "tsx scripts/verify-assets.ts",
    "validate:i18n": "tsx scripts/validate-translations.ts",
    "i18n:sync-en": "tsx scripts/sync-source-translations.ts"
  },
  "private": true,
  "license": "UNLICENSED"
}
